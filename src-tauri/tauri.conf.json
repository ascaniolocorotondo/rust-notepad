{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Notepad",
  "version": "0.1.0",
  "identifier": "com.rustnotepad.editor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rust Notepad",
        "width": 1100,
        "height": 720,
        "minWidth": 700,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Blocco note con blocchi di codice, esecuzione e assistente IA",
    "longDescription": "Rust Notepad è un blocco note leggero: scrivi testo, inserisci blocchi di codice con /code, eseguili e fatti aiutare da un assistente IA.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
